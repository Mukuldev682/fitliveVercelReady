# ── MongoDB (use MongoDB Atlas for Vercel) ──────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fitlive?retryWrites=true&w=majority

# ── Session ─────────────────────────────────────────────────────────
SESSION_SECRET=replace_with_a_long_random_string

# ── GROQ AI API ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Google OAuth / Google Fit ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# On Vercel, set this to your production URL:
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/googlefit/callback

# ── Email (for password reset) ───────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Node environment ─────────────────────────────────────────────────
NODE_ENV=production
